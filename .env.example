# Copie para .env apenas no ambiente local. Não versione segredos reais.
APP_NAME=API de Agendamento de Consultas
APP_ENV=development
DATABASE_URL=sqlite:///./data/appointments.db
DEBUG=false
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=clinic-scheduling-api
JWT_AUDIENCE=clinic-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_REQUESTS=120
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_CLIENT_TOKEN_REQUESTS=10

# Usados somente por scripts/seed_demo.py; substitua localmente e não versione o .env.
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_MFA_CODE=replace-with-six-digits
SEED_PROFESSIONAL_PASSWORD=replace-with-a-strong-professional-password
SEED_RECEPTION_PASSWORD=replace-with-a-strong-reception-password
SEED_LAB_CLIENT_SECRET=replace-with-a-strong-client-secret
